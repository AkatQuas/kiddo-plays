# ASR model directory (download from ModelScope / HuggingFace)
INPUT_PATH=./models

# OpenAI-compatible LLM (default: local Ollama)
# Install: https://ollama.com — then run: ollama pull qwen2.5:7b
LLM_API_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=4096

# Text corrector overrides (optional, fall back to LLM_* above)
TEXT_CORRECTOR_API_URL=
TEXT_CORRECTOR_API_KEY=
TEXT_CORRECTOR_MODEL=

# Hotword corrector overrides (optional, fall back to LLM_* above)
HOTWORD_API_URL=
HOTWORD_API_KEY=
HOTWORD_MODEL=

# Remote file download (optional — only needed when using filekey-based audio fetch)
OSS_ENDPOINT=
API_KEY=
API_SECRET=
OSS_QUERY_PARAM=object_key

# Shared deploy defaults
LOG_DIR=./logs
DEVICE=cuda
PLATFORM=NV
BACKGROUND=false

# Streaming ASR (must match streaming_asr/common/config.json network.port)
ASR_STREAM_PORT=36005
MAX_CLIENT=8
SESSION_DIR=./sessions

# HTTP ASR
ASR_HTTP_PORT=36008
TEMP_DIR=temp_dir/

# Voice wakeup
WAKEUP_HOST=0.0.0.0
WAKEUP_PORT=34010
WAKEUP_KEYWORDS=你好助手
WAKEUP_SIMILARITY_THRESHOLD=80

# Web debug UI (deploy/start_web.sh)
WEB_HOST=0.0.0.0
WEB_PORT=36004
