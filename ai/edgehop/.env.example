# Name of THIS device — must match one of the names in DEVICES below.
SELF_NAME=device2

# Ordered list of all devices in the group, laid out LEFT→RIGHT in this order.
# Format: name@host:port  (comma-separated)
# Moving the mouse off the left/right edge of a device switches focus to its
# neighbor in this list. Order matters.
DEVICES=device1@192.168.1.10:7788,device2@192.168.1.11:7788,device3@192.168.1.12:7788

# Pixels from the screen edge that count as an edge hit. 2 is safe.
EDGE_THRESHOLD=2

# Hotkey (uiohook key name) that forces focus back to this device.
# Default: ScrollLock. Set to "0" to disable.
# Common names: ScrollLock, F12, Pause
RECLAIM_HOTKEY_NAME=ScrollLock

# Sync text clipboard across peers so Cmd+C on Mac → Ctrl+V on Win works.
# true/false. Default true.
CLIPBOARD_SYNC=true

# How often to poll the local clipboard for changes (ms). 600 is a good default.
CLIPBOARD_POLL_MS=600

# Translate the "system" modifier across OSes:
#   Mac → Win/Linux : Cmd  (Meta) becomes Ctrl
#   Win/Linux → Mac : Ctrl        becomes Cmd (Meta)
# So Cmd+C on a Mac reaches a Windows peer as Ctrl+C, etc.
TRANSLATE_MODIFIERS=true
