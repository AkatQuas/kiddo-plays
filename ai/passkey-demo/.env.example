# Copy to server/.env for local turbo dev (Vite on :5173)
REDIS_URL=redis://localhost:6379
PORT=3000
RP_ID=localhost
RP_NAME=Passkey Demo
ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_SEC=86400
CHALLENGE_TTL_SEC=300
NODE_ENV=development

