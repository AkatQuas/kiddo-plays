    "@open-erp/runtime-core": "0.1.0",
    "@open-erp/storage-pg": "0.1.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.12.32",
    "postgres": "^3.4.7"
  }
