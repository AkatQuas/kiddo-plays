# Sample values for a local compose stack. Replace them before any shared deployment.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=open_enterprise
DATABASE_URL=postgres://app:app@postgres:5432/open_enterprise

RELEASE_ENV=local
IDENTITY_ISSUER=local
SESSION_SECRET=local-session-secret
SERVICE_TOKEN=local-service-token

ATTACHMENT_BACKEND=file
ATTACHMENT_DIR=/data/attachments

API_PORT=8080
AGENT_PORT=8090
AGENT_HOST_URL=http://agent:8090
API_BASE_URL=http://api:8080
WEB_PORT=8088

# Reference write API (port 8094). Same Postgres; schema via drizzle-kit push (oe_*).
OE_TIMEZONE=UTC
OE_REFERENCE_MIGRATE=1
# OE_REFERENCE_SCHEMA=push   # default; use "off" to skip push
OE_REFERENCE_TENANT_ID=reference-tenant
OE_REFERENCE_ORG_ID=reference-org
OE_REFERENCE_USER_ID=reference-user
# PORT=8094
