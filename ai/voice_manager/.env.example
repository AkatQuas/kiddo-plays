# Compose profiles (comma-separated): infra | app
#
# Local dev (pick one):
#   make dev-up   -> COMPOSE_PROFILES=infra,app  (local postgres + minio + app)
#   make dev-app  -> COMPOSE_PROFILES=app         (app only, remote infra via vars below)

COMPOSE_PROFILES=infra,app

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voice_manager
POSTGRES_PUBLISH_PORT=5432

# For make dev-app: point at test environment Postgres
# DATABASE_URL=postgresql://user:pass@test-pg.example.com:5432/voice_manager

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=voices
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# For make dev-app: point at test environment MinIO
# MINIO_ENDPOINT=test-minio.example.com:9000
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_SECURE=false

# ---------- Voice Manager ----------
VOICE_MANAGER_PORT=36800
CONFIG_PATH=config/config.docker.json
LOG_DIR=./logs

# External ASR/TTS (third-party stable dependencies; keep as-is)
# ASR_URL=http://some-asr-svc:8000/transcribe
# ASR_API_KEY=abc123
# TTS_URL=http://som-tts-svc:8000/v1/audio/speech
# TTS_API_KEY=abc123
