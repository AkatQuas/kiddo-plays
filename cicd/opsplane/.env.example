# Opsplane — copy to .env and fill placeholders.
# No authentication is built in. Bind to loopback or put behind your own gateway.

# Server
HOST=127.0.0.1
PORT=43200

# Store (optional for demo: omit to use in-memory store)
# DATABASE_URL=postgresql://opsplane:<password>@127.0.0.1:5432/opsplane

# Catalog (defaults to catalog/examples)
# CATALOG_DIR=./catalog/examples

# Optional Jenkins build provider
# JENKINS_BASE=https://jenkins.example.com
# JENKINS_USERNAME=<jenkins-username>
# JENKINS_API_TOKEN=<jenkins-api-token>

# Optional Docker build provider
# DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_REGISTRY=registry.example.com
# DOCKER_USERNAME=<registry-username>
# DOCKER_PASSWORD=<registry-password>

# Optional Kubernetes monitor (in-cluster SA by default when running in a pod)
# K8S_NAMESPACE=default
# KUBECONFIG=/path/to/kubeconfig

# Optional metrics / log backends for monitor enrichment
# MONITOR_PROM_BASE=https://prometheus.example.com
# MONITOR_LOGS_BASE=https://logs.example.com

# Timeouts
BUILD_POLL_TIMEOUT_MS=1800000
CI_POLL_TIMEOUT_MS=900000
