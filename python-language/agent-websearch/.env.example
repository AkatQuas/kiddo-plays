# API auth (Bearer token required for all routes except /health)
API_BEARER_TOKEN=

# Official search provider keys (comma-separated for rotation; leave empty to skip)
TAVILY_API_KEY=
SERPAPI_API_KEY=
TINYFISH_API_KEY=
BRAVE_API_KEY=

# Provider order when source is not specified
SEARCH_PROVIDER_ORDER=tinyfish,tavily,serpapi,brave

# Optional local blocklist file (one phrase per line). Empty = disabled.
SENSITIVE_WORDS_PATH=

# S3-compatible object storage (boto3 SDK)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true

# Server
HOST=0.0.0.0
PORT=9030
