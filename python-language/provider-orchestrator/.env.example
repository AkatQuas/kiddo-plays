# Copy to .env and fill in local values. Never commit real secrets.

# Comma-separated provider API keys for the demo product adapter
DEMO_PROVIDER_KEYS=key-a,key-b,key-c

# Per-key soft limits (educational defaults)
KEY_HOUR_LIMIT=100
KEY_MONTH_LIMIT=5000

# Token pool size for sliding-window rate limiting demos
TOKEN_POOL_SIZE=3
TOKEN_POOL_QPS_PER_TOKEN=1.0

# Cache TTL seconds
CACHE_TTL_SECONDS=86400

# Optional: educational proxy list (learning / discussion only — not for production commerce)
# Format: http://user:pass@host:port, one URL per comma
# LEARNING_PROXY_URLS=
# LEARNING_PROXY_ENABLED=false

# Management API
MANAGEMENT_HOST=127.0.0.1
MANAGEMENT_PORT=8080
MANAGEMENT_API_TOKEN=change-me
