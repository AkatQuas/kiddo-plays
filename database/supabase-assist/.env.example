PORT=3010

# Supabase JWT signing secret (same as project JWT secret)
SUPABASE_JWT_SECRET=change-me-supabase-jwt-secret

# Public anon key returned to clients (optional)
SUPABASE_ANON_KEY=

# Postgres connection used by /schema/* (privileged; protect with DynCode + gateway)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# X-Dyn-Code TOTP shared secret (base32). Replace before any real use.
DYN_CODE_SECRET=DEMOSECRETBASE32FOROPENSOURCEA

# Default access token lifetime (seconds)
ACCESS_TOKEN_EXPIRES_IN=3600

# uuidv5 namespace for deterministic JWT sub derived from user id
JWT_SUB_UUIDV5_NAMESPACE=9f8e7d6c-5b4a-41a0-9c21-0fedcba98765

# Set to 1 to log expected TOTP windows on miss (ops debug only)
DEBUG_DYN_CODE=0
